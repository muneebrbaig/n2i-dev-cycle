# n2i-dev-cycle skill config.
# Copy to .n2i-dev-cycle.env (gitignored). All keys optional — skill falls back to defaults when unset.

# Branch name prefix for new feature branches (e.g. "mb/" → mb/17-add-foo).
# Default: derived from git user initials, else "dev/".
BRANCH_PREFIX=mb/

# Default scope when BOTH backend and frontend are detected and no scope token given.
# One of: backend | frontend | both. Default: ask (skill prompts when unset).
# DEFAULT_SCOPE=both

# Force forge instead of auto-detecting from git remote. Optional.
# One of: gitlab | github. Default: auto-detect from remote URL.
# FORGE=gitlab

# Migration-mode status doc filename (searched within the repo). Optional.
# Enables Migration input mode + status-table updates. Default: migration mode off.
# MIGRATION_DOC=migration-status.md
